{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "block-no-empty": true,
    "color-no-invalid-hex": true,
    "selector-max-id": 1,
    "selector-no-qualifying-type": [
      true,
      { "ignore": ["attribute", "class"] }
    ],
    "selector-type-no-unknown": null,
    "unit-allowed-list": ["rem", "px", "fr", "%", "vh", "vw", "s", "deg", "ms"]
  }
}
